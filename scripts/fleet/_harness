# shellcheck shell=bash
# Codex is the fleet's only harness. Legacy markers are ignored for new sessions.
fleet_harness_file() {
  echo "${UNSEAMLESS_FLEET_DIR:-$HOME/.local/share/unseamless-fleet}/harness"
}

fleet_harness() { echo codex; }

fleet_worker_harness() {
  local marker=""
  marker="$(cat "${UNSEAMLESS_FLEET_DIR:-$HOME/.local/share/unseamless-fleet}/assignments/$1.harness" 2>/dev/null || true)"
  case "$marker" in
    codex) echo codex ;;
    *) echo "worker '$1' used a retired harness; finish or recreate it before using the Codex fleet" >&2; return 1 ;;
  esac
}

fleet_orchestrator_harness() {
  local marker=""
  marker="$(cat "${UNSEAMLESS_FLEET_DIR:-$HOME/.local/share/unseamless-fleet}/orchestrator.harness" 2>/dev/null || true)"
  if [ "$marker" = codex ]; then echo codex; else
    echo "orchestrator predates the Codex migration; restart it with orch-stop and orch-start before messaging or attaching" >&2
    return 1
  fi
}
