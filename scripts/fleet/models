#!/usr/bin/env bash
# List locally cached Codex model IDs.
set -euo pipefail
case "${1:-codex}" in codex) ;; *) echo "usage: models [codex]" >&2; exit 2 ;; esac

list_codex() {
  echo "codex (slugs, from ~/.codex/models_cache.json):"
  local cache="$HOME/.codex/models_cache.json" ids=""
  if command -v jq >/dev/null 2>&1 && [ -r "$cache" ]; then
    ids="$(jq -r '.models[] | select(.visibility == "list") | .slug' "$cache" 2>/dev/null || true)"
  fi
  if [ -z "$ids" ]; then
    # Empty covers cache/jq missing, JSON not parsing, and nothing being
    # visibility=="list" -- all collapse to "no live list", so say that.
    ids="$(printf '%s\n' gpt-5.5 gpt-5.4 gpt-5.4-mini)"
    echo "  (no list from ~/.codex/models_cache.json; static fallback of 2026-07-03)"
  fi
  awk '{print "  " $0}' <<<"$ids"
}

list_codex
