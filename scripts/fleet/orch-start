#!/usr/bin/env bash
# Launch or attach the Codex orchestrator. --continue resumes its last session.
# Fresh sessions receive the STATE.md orientation prompt unless --no-seed is given.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SELF/../.." && pwd)"
RIFTS="$HOME/Code/.rifts/$(basename "$REPO")"
FLEET_DIR="${UNSEAMLESS_FLEET_DIR:-$HOME/.local/share/unseamless-fleet}"
sess="usc-orch"

# shellcheck source=scripts/fleet/_harness
source "$SELF/_harness"
harness="$(fleet_harness)"

BOOT_PROMPT='Boot: read docs/STATE.md -- it is about the work (Now / Next / candidates), not machine state. Give Michael a short brief: where things stand and what Next is. Do NOT audit machine state to orient (no worker-ls / rig-status sweep -- workers are on worker-ls only if you need it, and the rig is cheap to re-apply if a rig task comes up). This boot prompt alone is orientation, not a request to start work: wait after the brief unless the user launched this session with an instruction to continue the project. When they did, begin the recorded Next without asking again; pause only at a real human gate or consequential unresolved choice.'
seed=1
args=()
for a in "$@"; do
  if [ "$a" = "--no-seed" ]; then
    seed=0
    continue
  fi
  case "$a" in --continue) seed=0 ;; esac
  args+=("$a")
done
set -- ${args[@]+"${args[@]}"}
seed_args=()
if [ "$seed" = 1 ]; then
  seed_args=("$BOOT_PROMPT")
fi

mkdir -p "$RIFTS"

place_self() {
  [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ] || return 0
  [ -x "$SELF/_place-inject" ] || return 0
  setsid -f "$SELF/_place-inject" "$sess" >/dev/null 2>&1 || true
}

if tmux has-session -t "$sess" 2>/dev/null; then
  fleet_orchestrator_harness >/dev/null
  echo "orchestrator session '$sess' already running; attaching."
  place_self
  exec tmux attach -t "$sess"
fi

cd "$REPO"
if [ "$harness" = "codex" ]; then
  # shellcheck source=scripts/fleet/_codex
  source "$SELF/_codex"
  fleet_codex_trust_add "$REPO"
  codex_cmd=(codex)
  if [ "${1:-}" = "--continue" ]; then
    shift
    codex_cmd=(codex resume --last)
  fi
  tmux new-session -d -s "$sess" -c "$REPO" \
    env UNSEAMLESS_FLEET_DIR="$FLEET_DIR" \
    "${codex_cmd[@]}" \
    -c "sandbox_mode=\"danger-full-access\"" \
    -c "sandbox_workspace_write.network_access=true" \
    -c "sandbox_workspace_write.writable_roots=[\"$REPO/.git\",\"$HOME/.cargo\",\"$FLEET_DIR\"]" "$@" \
    ${seed_args[@]+"${seed_args[@]}"}
  mkdir -p "$FLEET_DIR"
  printf 'codex\n' >"$FLEET_DIR/orchestrator.harness"
  place_self
  exec tmux attach -t "$sess"
fi
