#!/usr/bin/env bash
# Report the sole supported fleet harness. Keep `codex` and `toggle` as no-op
# compatibility arguments for existing desktop shortcuts.
set -euo pipefail
case "${1:-}" in
  ""|codex|toggle) echo codex ;;
  *) echo "usage: harness [codex] (the fleet uses Codex only)" >&2; exit 2 ;;
esac
