{
  "permissions": {
    "additionalDirectories": [
      "/home/michael/.local/share/unseamless-fleet"
    ],
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fetch:*)",
      "Bash(scripts/test-core.sh:*)",
      "Bash(scripts/fleet/msg:*)",
      "Bash(scripts/fleet/worker-ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(scripts/rig.sh:*)",
      "Bash(scripts/deck.sh:*)",
      "Bash(python3 scripts/re/watch-write.py:*)",
      "Bash(python3 scripts/re/watch-bt.py:*)",
      "Bash(python3 scripts/re/scan-vtable.py:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(scripts/fleet/notify-human:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/notify/activity-hook start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/notify/activity-hook busy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/notify/activity-hook busy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/notify/activity-hook idle"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/notify/activity-hook end"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/notify/notification-hook"
          }
        ]
      }
    ]
  }
}
